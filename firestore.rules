rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /kaarigars/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && 
        (resource == null || resource.data.uid == request.auth.uid) && 
        (request.resource == null || request.resource.data.uid == request.auth.uid)
      );
    }
    
    match /orders/{docId} {
      allow read: if isAdmin() ||
        (request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.kaarigarId == request.auth.uid));
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;

      // The assigned kaarigar may update job status/photos on their own order, nothing else.
      // Customers may self-report completion (since kaarigars have no working portal, the
      // customer is the most reliable real-time signal) — but only forward, into 'done'.
      // Customers may also add a rating, once the job is marked done.
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.kaarigarId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'beforePhotoUrl', 'afterPhotoUrl'])) ||
        (request.auth != null && resource.data.customerId == request.auth.uid &&
          resource.data.status in ['pending', 'progress', 'ready'] &&
          request.resource.data.status == 'done' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt', 'completedBy'])) ||
        (request.auth != null && resource.data.customerId == request.auth.uid &&
          resource.data.status == 'done' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewText', 'ratingDate']));

      allow delete: if isAdmin();
    }
    
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
